# Kitchen App Environment Variables
# Copy this file to .env and fill in your values
#
# For GitHub Pages (static hosting):
#   - The publishable key is safe to commit (RLS enforces security server-side)
#   - Edit config.js directly, OR
#   - Use a build step to inject these values into window.__KITCHEN_ENV__
#
# For local development with a build tool (Vite, Next.js, etc.):
#   - Set these in your .env file
#   - Your build tool will inject them at build time

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative naming (if using Vite)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Enable debug logging
DEBUG_MODE=false
